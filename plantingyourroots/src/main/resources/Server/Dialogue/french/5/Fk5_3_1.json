  "Entries": [
    {
      "Name": "Narrator",
      "Line": "French Kweebec's expression completely shatters. At first, he's shocked -- moments after, however, his bark folds into a frown.",
      "Sprite":"sprites/Kweebec_French_Angry.png"
    },
    {
      "Name": "French Kweebec",
      "Line": "What do you mean ? I *am* French. It is très flagrant, non ?",
      "Sprite":"sprites/Kweebec_French_Angry.png"
    }
  ],
  "AdvanceText": "Continue",
  "End": {
    "Type": "Standard",
    "Line": {
      "Id": "Standard",
      "Text": "I show off so much of ma culture that I did not think I left many opportunités for doubt."
    },
